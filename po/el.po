msgstr "Σφάλμα AI"

#: src/ui/main_window.rs:920
msgid "Select a message first."
msgstr "Επιλέξτε πρώτα ένα μήνυμα."

#: src/ui/main_window.rs:931
msgid "No text to edit."
msgstr "Δεν υπάρχει κείμενο για επεξεργασία."

#: src/ui/main_window.rs:937
msgid "Enable the LLM in Settings → LLM to use Voice edit."
msgstr "Ενεργοποιήστε το LLM στις Ρυθμίσεις → LLM για να χρησιμοποιήσετε τη Φωνητική επεξεργασία."

#: src/ui/main_window.rs:945
msgid "Busy — finish the current recording first."
msgstr "Απασχολημένο — ολοκληρώστε πρώτα την τρέχουσα εγγραφή."

#: src/ui/main_window.rs:957
msgid "Listening for your edit… click \"Stop edit\" when done"
msgstr "Ακρόαση για την επεξεργασία σας… πατήστε \"Διακοπή επεξεργασίας\" όταν τελειώσετε"

#: src/ui/main_window.rs:983
msgid "Microphone stopped — finishing the edit."
