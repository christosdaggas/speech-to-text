msgstr "Οδηγία κώδικα"

#: src/ui/settings/dictation.rs:259
msgid "Mode"
msgstr "Λειτουργία"

#: src/ui/settings/dictation.rs:320
msgid "Enable auto-paste?"
msgstr "Ενεργοποίηση αυτόματης επικόλλησης;"

